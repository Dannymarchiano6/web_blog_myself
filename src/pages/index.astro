---
import { getCollection } from 'astro:content';
import BlogCard from '../components/BlogCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 3);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'id'),
);
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-16 sm:px-8 sm:pb-24 sm:pt-24">
    <div class="max-w-3xl">
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-medium text-indigo-800 dark:border-indigo-900 dark:bg-indigo-950/60 dark:text-indigo-300"
      >
        <span class="size-1.5 rounded-full bg-indigo-500"></span>
        Catatan personal dari Danny Marchiano
      </p>
      <h1
        class="text-4xl font-semibold leading-tight tracking-tight text-stone-950 sm:text-6xl sm:leading-[1.08] dark:text-white"
      >
        Ide sederhana untuk web yang <span class="text-indigo-600 dark:text-indigo-400"
          >lebih baik.</span
        >
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-stone-600 sm:text-lg sm:leading-8 dark:text-stone-300">
        Ruang untuk berbagi catatan tentang desain, teknologi, dan proses membuat sesuatu di internet
        — dengan lebih banyak rasa ingin tahu dan lebih sedikit kebisingan.
      </p>
      <a
        href="/blog"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-stone-950 px-5 py-3 text-sm font-medium text-white transition hover:bg-indigo-700 dark:bg-white dark:text-stone-950 dark:hover:bg-indigo-200"
      >
        Jelajahi tulisan <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="border-y border-stone-200 bg-white/70 dark:border-stone-800 dark:bg-stone-900/30">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-indigo-700 dark:text-indigo-400">Dari blog</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Tulisan terbaru</h2>
        </div>
        <a
          href="/blog"
          class="shrink-0 text-sm font-medium text-stone-600 transition hover:text-indigo-700 dark:text-stone-300 dark:hover:text-indigo-400"
        >
          Semua tulisan <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        latestPosts.length > 0 ? (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {latestPosts.map((post) => <BlogCard post={post} />)}
          </div>
        ) : (
          <p class="rounded-2xl border border-dashed border-stone-300 p-8 text-stone-600 dark:border-stone-700 dark:text-stone-300">
            Belum ada artikel. Tambahkan file Markdown ke <code>src/content/blog/</code>.
          </p>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-indigo-700 dark:text-indigo-400">Jelajahi topik</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Yang sering dibahas</h2>
      <p class="mt-3 text-sm leading-6 text-stone-600 dark:text-stone-300">
        Kumpulan topik dari tulisan yang pernah saya bagikan.
      </p>
    </div>
    <div class="mt-6 flex flex-wrap gap-2.5">
      {
        tags.length > 0 ? (
          tags.map((tag) => (
            <span class="rounded-full border border-stone-200 bg-white px-4 py-2 text-sm text-stone-700 dark:border-stone-800 dark:bg-stone-900 dark:text-stone-300">
              {tag}
            </span>
          ))
        ) : (
          <p class="text-sm text-stone-500 dark:text-stone-400">
            Tag akan muncul setelah artikel diterbitkan.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
