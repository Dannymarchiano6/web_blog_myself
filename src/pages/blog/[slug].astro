---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.pubDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={`${post.data.title} — Danny Marchiano`} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-16">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-sm font-medium text-stone-500 transition hover:text-indigo-700 dark:text-stone-400 dark:hover:text-indigo-400"
    >
      <span aria-hidden="true">←</span> Kembali ke blog
    </a>

    <header class="mt-10">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-stone-500 dark:text-stone-400">
        <time datetime={post.data.pubDate.toISOString()}>{date}</time>
        <span aria-hidden="true">·</span>
        <span>Oleh {post.data.author}</span>
      </div>
      <h1 class="mt-5 text-3xl font-semibold leading-tight tracking-tight sm:text-5xl sm:leading-tight">
        {post.data.title}
      </h1>
      <p class="mt-5 text-lg leading-8 text-stone-600 dark:text-stone-300">
        {post.data.description}
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          post.data.tags.map((tag) => (
            <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-stone-600 dark:bg-stone-800 dark:text-stone-300">
              {tag}
            </span>
          ))
        }
      </div>
      <img
        src={post.data.image}
        alt=""
        fetchpriority="high"
        class="mt-9 aspect-[16/9] w-full rounded-2xl object-cover"
      />
    </header>

    <div
      class="prose prose-stone mt-10 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-a:font-medium prose-a:text-indigo-700 prose-img:rounded-xl dark:prose-invert dark:prose-a:text-indigo-400"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
